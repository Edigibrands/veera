{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/api/upload", "dest": "/api/upload.js" },
    { "src": "/api/calculate", "dest": "/api/calculate.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
